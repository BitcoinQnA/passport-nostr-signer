+
+// Endpoint-level interrupt for non-DMA (PIO) endpoints 8..=15. The
+// UDPHS only has 8 DMA channels but 16 endpoints; overflow endpoints
+// use endpoint-status interrupts instead of DMA interrupts.
+#[derive(Debug, server::Message, Clone)]
+pub struct PioEndpointInterrupt {
+    pub endpoint: u8,
+    pub status_raw: u32,
+}
+
+impl AsScalar<2> for PioEndpointInterrupt {
+    fn as_scalar(&self) -> [u32; 2] { [self.endpoint as u32, self.status_raw] }
+}
+
+impl FromScalar<2> for PioEndpointInterrupt {
+    fn from_scalar(value: [u32; 2]) -> Self { Self { endpoint: value[0] as u8, status_raw: value[1] } }
+}
