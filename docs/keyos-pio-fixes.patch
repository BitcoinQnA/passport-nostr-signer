+impl ScalarHandler<PioEndpointInterrupt> for UsbDeviceServer {
+    fn handle(
+        &mut self,
+        msg: PioEndpointInterrupt,
+        sender: xous::PID,
+        _context: &mut server::ServerContext<Self>,
+    ) {
+        if sender != xous::current_pid().unwrap() {
+            return;
+        }
+        let ep_num = msg.endpoint;
+        let status = EndpointStatus(msg.status_raw);
+        log::trace!(
+            "PIO IRQ EP{ep_num}: rx_out={} tx_compl={} tx_ready={} byte_count={} raw=0x{:08x}",
+            status.received_out(),
+            status.transmission_complete(),
+            status.tx_packet_ready(),
+            status.byte_count(),
+            msg.status_raw,
+        );
+
+        // Copy client buffer pointer / length before mutably re-borrowing self.
+        let Some(endpoint) = self.endpoints.get(&ep_num) else {
+            log::warn!("PIO IRQ on unregistered EP{ep_num}; ignoring");
+            return;
+        };
+        let is_out = endpoint.properties.ep_direction == EndpointDirection::Out;
+
+        if is_out {
+            // Host→device packet available. If a client is waiting, copy
+            // data out of the bank and resolve. If not, drop the packet
+            // to unblock the endpoint.
+            let byte_count = status.byte_count() as usize;
+            let ep_hw = self.hw.endpoint(ep_num as usize);
+            let mut clear = EndpointStatus(0);
+            clear.set_received_out(true);
+
+            if status.received_out() {
+                let ongoing = self.endpoints.get_mut(&ep_num).and_then(|e| e.ongoing_read.take());
+                match ongoing {
+                    Some(mut read) => {
+                        let capacity = read.body().length as usize;
+                        let to_copy = byte_count.min(capacity);
+                        let dst = unsafe {
+                            std::slice::from_raw_parts_mut(read.body().buf.as_ptr() as *mut u8, to_copy)
+                        };
+                        self.hw.read_endpoint_memory(ep_num as usize, 0, dst);
+                        // Free the bank for the next packet.
+                        self.hw.endpoint(ep_num as usize).status_clr.set(clear);
+                        read.set_response(Ok(to_copy));
+                    }
+                    None => {
+                        // No user-space reader is ready; stash this packet
+                        // on the endpoint's queue so the next `read_buf`
+                        // can drain it instead of the bytes being lost.
+                        let ep_entry = self.endpoints.get_mut(&ep_num);
+                        let queue_full = ep_entry
+                            .as_ref()
+                            .map(|e| e.rx_queue.len() >= RX_QUEUE_MAX_PACKETS)
+                            .unwrap_or(true);
+                        if queue_full {
+                            log::warn!(
+                                "PIO EP{ep_num} RXOUT: queue full ({RX_QUEUE_MAX_PACKETS} packets); \
+                                 dropping {byte_count} bytes"
+                            );
+                        } else {
+                            let mut buf = vec![0u8; byte_count];
+                            self.hw.read_endpoint_memory(ep_num as usize, 0, &mut buf);
+                            if let Some(ep) = ep_entry {
+                                ep.rx_queue.push_back(buf);
+                            }
+                        }
+                        self.hw.endpoint(ep_num as usize).status_clr.set(clear);
+                    }
+                }
+            } else {
+                // Spurious / unrelated event — just clear whatever's set.
+                ep_hw.status_clr.set(status);
+            }
+        } else {
+            // Device→host packet transmitted (TXCOMPL). Resolve the
+            // pending write and clear the status so the next write can
+            // fire.
+            if status.transmission_complete() {
+                let mut clear = EndpointStatus(0);
+                clear.set_transmmission_complete(true);
+                self.hw.endpoint(ep_num as usize).status_clr.set(clear);
+                if let Some(mut write) =
+                    self.endpoints.get_mut(&ep_num).and_then(|e| e.ongoing_write.take())
+                {
+                    let length = write.body().length as usize;
+                    write.set_response(Ok(length));
+                }
+            } else {
+                // Clear any non-TXCOMPL bits to avoid re-interrupting.
+                self.hw.endpoint(ep_num as usize).status_clr.set(status);
+            }
+        }
+
+        // The IRQ handler masked this endpoint's top-level interrupt to
+        // avoid a storm while the per-endpoint status bits were still
+        // latched. We've now cleared them above, so it is safe to
+        // re-arm the endpoint for the next packet.
+        self.hw.enable_endpoint_interrupt(ep_num as usize);
+    }
+}
