{
  "manifest_version": 3,
  "name": "Passport Prime Nostr Signer (1.3 / WebUSB)",
  "short_name": "Prime Signer (1.3)",
  "version": "0.2.0",
  "description": "Sign Nostr events on your Passport Prime over WebUSB. The nsec never leaves the device.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Passport Prime Nostr Signer"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
